# Copy this file to .env and fill in your real values. Never commit .env.

# Get this from your Neon dashboard -> Connection Details
# It looks like: postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://user:password@your-neon-host/dbname?sslmode=require

# Any long random string works. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

PORT=5000
